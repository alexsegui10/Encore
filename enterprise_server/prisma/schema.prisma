generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ========================================================
// ENUMS
// ========================================================

enum EnterpriseStatus {
  active
  suspended
  pending
}

enum ProductStatus {
  draft
  active
  hidden
  soldout
}

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  completed
  failed
  cancelled
}

enum TicketStatus {
  valid
  used
  cancelled
}

// ========================================================
// MODELOS BASE DE EMPRESA
// ========================================================

model Enterprise {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  uid          String        @unique
  name         String
  description  String?
  logo         String?
  website      String?
  contactEmail String?
  phone        String?
  status       EnterpriseStatus @default(pending)
  isVerified   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  productCategories ProductCategory[]
  products          Product[]
}

model ProductCategory {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  image       String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  enterprise  Enterprise?   @relation(fields: [enterpriseId], references: [id])
  enterpriseId String?      @db.ObjectId

  products    Product[]
}

model Product {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  price          Float
  currency       String        @default("EUR")
  stockTotal     Int           @default(0)
  stockAvailable Int           @default(0)
  image          String?
  status         ProductStatus @default(draft)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relaciones
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  categoryId     String?          @db.ObjectId

  enterprise     Enterprise?      @relation(fields: [enterpriseId], references: [id])
  enterpriseId   String?          @db.ObjectId

  orderItems     OrderItem[]
}

// ========================================================
// FUTUROS MÓDULOS: COMPRAS, PAGOS, TICKETS
// ========================================================
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  uid       String   @unique
  email     String   @unique
  username  String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  tickets   Ticket[]
}

model Order {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  totalAmount Float
  status      OrderStatus  @default(pending)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  userId      String       @db.ObjectId

  items       OrderItem[]
  payment     Payment?
}

model OrderItem {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  quantity    Int
  unitPrice   Float
  product     Product     @relation(fields: [productId], references: [id])
  productId   String      @db.ObjectId
  order       Order       @relation(fields: [orderId], references: [id])
  orderId     String      @db.ObjectId

  tickets     Ticket[]
}

model Payment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  amount          Float
  method          String
  transactionRef  String?
  currency        String         @default("EUR")
  status          PaymentStatus  @default(pending)
  paidAt          DateTime?
  createdAt       DateTime       @default(now())

  order           Order          @relation(fields: [orderId], references: [id])
  orderId         String         @unique @db.ObjectId
}

model Ticket {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  uniqueCode    String        @unique
  status        TicketStatus  @default(valid)
  issuedAt      DateTime      @default(now())
  usedAt        DateTime?

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
  orderItemId   String        @db.ObjectId

  user          User          @relation(fields: [userId], references: [id])
  userId        String        @db.ObjectId
}