# Enterprise Gateway Dockerfile
FROM node:20-alpine

WORKDIR /app

# Instalar herramientas necesarias
RUN apk add --no-cache netcat-openbsd

# Copiar package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./

# Instalar dependencias
RUN npm ci

# Copiar código fuente
COPY src ./src

# Build de TypeScript
RUN npm run build

# Exponer puerto
EXPOSE 5000

CMD ["npm", "run", "start:prod"]
