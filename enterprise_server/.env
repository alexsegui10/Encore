DATABASE_URL="mongodb://127.0.0.1:27017/encore"
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

JWT_SECRET="your-secret-key-must-be-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="encore-enterprise"

# Microservices URLs
ENTERPRISE_SERVICE_URL=http://localhost:5001
PRODUCT_SERVICE_URL=http://localhost:5002
CATEGORY_SERVICE_URL=http://localhost:5003

# Enterprise Service Configuration
ENTERPRISE_SERVICE_PORT=5001

# Product Service Configuration
PRODUCT_SERVICE_PORT=5002

# Category Service Configuration
CATEGORY_SERVICE_PORT=5003
