generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  blocked
  pending
}

enum CategoryStatus {
  active
  hidden
  archived
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  uid       String   @unique
  username  String   @unique
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventStatus {
  draft
  published
  cancelled
}

model users {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  uid             String     @unique
  slug            String     @unique
  username        String     @unique
  email           String     @unique
  password        String
  bio             String     @default("")
  image           String?
  isActive        Boolean    @default(true)
  status          UserStatus @default(active)
  role            String     @default("client")
  favouriteEvents String[]   @db.ObjectId
  followingUsers  String[]   @db.ObjectId
  comentarios     String[]   @db.ObjectId
  reservas        String[]   @db.ObjectId
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  orders          Order[]
  tickets         Ticket[]
}

model categories {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String         @unique
  description String?
  image       String?
  isActive    Boolean        @default(true)
  status      CategoryStatus @default(active)
  eventos     String[]       @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model events {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  slug            String      @unique
  title           String
  date            DateTime
  price           Float
  currency        String      @default("EUR")
  location        String?
  description     String?
  category        String
  status          EventStatus @default(draft)
  isActive        Boolean     @default(true)
  mainImage       String?
  favouritesCount Int         @default(0)
  images          String[]
  merchandising   Json?       @default("[]")
  comments        String[]    @db.ObjectId
  stock           Int?        // null = unlimited stock
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]
}

// ========================================================
// PAYMENT SYSTEM ENUMS
// ========================================================

enum OrderStatus {
  pending
  paid
  cancelled
  refunded
  failed
}

enum PaymentStatus {
  pending
  completed
  failed
  cancelled
}

enum TicketStatus {
  valid
  used
  cancelled
}

// ========================================================
// PAYMENT SYSTEM MODELS
// ========================================================

model Product {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  price          Float
  currency       String        @default("EUR")
  stockTotal     Int           @default(0)
  stockAvailable Int           @default(0)
  image          String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderItems     OrderItem[]
}

model Order {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  uid             String       @unique
  totalAmount     Float
  currency        String       @default("EUR")
  status          OrderStatus  @default(pending)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userId          String       @db.ObjectId
  user            users        @relation(fields: [userId], references: [id])

  items           OrderItem[]
  payment         Payment?
}

model OrderItem {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  quantity    Int
  unitPrice   Float
  itemType    String      // "event" or "product"
  
  productId   String?     @db.ObjectId
  product     Product?    @relation(fields: [productId], references: [id])
  
  eventId     String?     @db.ObjectId
  event       events?     @relation(fields: [eventId], references: [id])
  
  orderId     String      @db.ObjectId
  order       Order       @relation(fields: [orderId], references: [id])

  tickets     Ticket[]
}

model Payment {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  amount          Float
  method          String         @default("stripe")
  transactionRef  String?        @unique // Stripe PaymentIntent ID
  currency        String         @default("EUR")
  status          PaymentStatus  @default(pending)
  paidAt          DateTime?
  createdAt       DateTime       @default(now())

  orderId         String         @unique @db.ObjectId
  order           Order          @relation(fields: [orderId], references: [id])
}

model Ticket {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  uniqueCode    String        @unique
  status        TicketStatus  @default(valid)
  issuedAt      DateTime      @default(now())
  usedAt        DateTime?

  orderItemId   String        @db.ObjectId
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  userId        String        @db.ObjectId
  user          users         @relation(fields: [userId], references: [id])
}
