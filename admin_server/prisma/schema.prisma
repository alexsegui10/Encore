generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  blocked
  pending
}

enum CategoryStatus {
  active
  hidden
  archived
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  uid       String   @unique
  username  String   @unique
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EventStatus {
  draft
  published
  cancelled
}

model users {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  uid             String     @unique
  slug            String     @unique
  username        String     @unique
  email           String     @unique
  password        String
  bio             String     @default("")
  image           String?
  isActive        Boolean    @default(true)
  status          UserStatus @default(active)
  role            String     @default("client")
  favouriteEvents String[]   @db.ObjectId
  followingUsers  String[]   @db.ObjectId
  comentarios     String[]   @db.ObjectId
  reservas        String[]   @db.ObjectId
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model categories {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String         @unique
  description String?
  image       String?
  isActive    Boolean        @default(true)
  status      CategoryStatus @default(active)
  eventos     String[]       @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model events {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  slug            String      @unique
  title           String
  date            DateTime
  price           Float
  currency        String      @default("EUR")
  location        String?
  description     String?
  category        String
  status          EventStatus @default(draft)
  isActive        Boolean     @default(true)
  mainImage       String?
  favouritesCount Int         @default(0)
  images          String[]
  merchandising   Json?       @default("[]")
  comments        String[]    @db.ObjectId
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
